e":87,"performanceDetails":[6,6,10],"customChecks":{},"leaderScore":9,"leaderComment":"入社からまだ日が浅い中でも、業務への理解を着実に深め、東京案件を任せられるだけの力量が身についてきている点を評価しています。案件の意図を汲み取りながら、自分なりに考えて進めようとする姿勢があり、短期間で大きな成長が見られます。","typeScore":21,"bonusScore":5,"period":"上期","generalComment":"AIを活用した業務に積極的に取り組み、制作の効率化だけでなく、表現の幅を広げる力を大きく伸ばしている点を評価しています。新しい技術を単なるツールとして使うだけでなく、自分の表現や制作物の質を高めるために活かそうとする姿勢が見られます。\n\nまた、表現者としての視点や感性にも成長が感じられ、アウトプットの完成度や提案力にも変化が出てきています。今後は、AI活用力と自身のクリエイティブ力をさらに掛け合わせ、チームの制作力向上にも貢献していくことを期待しています。","selfComment":"","teamScore":0,"staffId":"9","evaluationDate":"2026-06-17","reviewer":"福永","updatedAt":"2026-06-17T23:00:46.401Z","teamTexts":["","",""],"commonScore":19,"themeScore":11,"id":"9-2026-上期"},{"bonusScore":0,"staffId":"9","teamTexts":["","",""],"leaderScore":0,"period":"下期","updatedAt":"2026-09-24T03:02:24.789Z","customChecks":{"mid_check_3":true,"mid_check_2":true},"id":"9-2026-下期","teamDetails":[0,0,0],"evaluationDate":"2026-09-24","teamScore":0,"generalComment":"","performanceScore":20,"themeScore":8,"typeScore":18,"bonusComment":"","themeDetails":[3,3,2],"themeTexts":["","",""],"year":2026,"commonDetails":[3,2,3,3,3],"totalScore":60,"entries":[{"finalScore":3,"primaryScore":3,"secondaryScore":0,"comment":"","selfScore":0,"itemId":"1778944251216"},{"itemId":"表現者タイプ|1","secondaryScore":0,"primaryScore":4,"finalScore":4,"selfScore":0,"comment":""},{"finalScore":4,"primaryScore":4,"secondaryScore":0,"selfScore":0,"itemId":"表現者タイプ|2","comment":""},{"finalScore":3,"itemId":"表現者タイプ|3","primaryScore":3,"comment":"","selfScore":0,"secondaryScore":0},{"primaryScore":4,"selfScore":0,"finalScore":4,"itemId":"表現者タイプ|4","secondaryScore":0,"comment":""}],"commonScore":14,"leaderComment":"","performanceDetails":[8,4,8],"reviewer":"","selfComment":""}]}
